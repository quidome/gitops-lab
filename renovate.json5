{
  extends: [
    'config:recommended',
    'mergeConfidence:all-badges',
  ],
  kubernetes: {
    enabled: true,
    managerFilePatterns: [
      '/\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      enabled: true,
    },
    {
      matchUpdateTypes: ['minor', 'patch'],
    },
  ],
}
