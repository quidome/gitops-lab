repositories: []

releases:
  - name: renovate
    namespace: gitops
    chart: ./helm-chart
    wait: true
    timeout: 300
    values:
      - helm-chart/values.yaml
      - renovateToken: {{ fetchSecretValue "ref+vault://kv/gitops/renovate#RENOVATE_TOKEN" | quote }}
        githubComToken: {{ fetchSecretValue "ref+vault://kv/gitops/renovate#GITHUB_COM_TOKEN" | quote }}
