repositories:
  - name: jetstack
    url: https://charts.jetstack.io

releases:
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.20.0
    values:
      - values.yaml
  - name: cert-manager-resources
    namespace: cert-manager
    chart: ./resources
    values:
      - cloudflare:
          apiToken: {{ fetchSecretValue "ref+vault://kv/security/cert-manager#api-token" | quote }}
          email: {{ fetchSecretValue "ref+vault://kv/security/cert-manager#email" | quote }}
