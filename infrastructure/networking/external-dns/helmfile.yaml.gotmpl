repositories:
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns

releases:
  - name: external-dns-pihole-a
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - extraArgs:
          - --pihole-server=http://pihole-a-web.networking.svc.cluster.local
          - --pihole-api-version=6
        env:
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_PIHOLE_PASSWORD" | quote }}

  - name: external-dns-pihole-b
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - extraArgs:
          - --pihole-server=http://pihole-b-web.networking.svc.cluster.local
          - --pihole-api-version=6
        env:
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_PIHOLE_PASSWORD" | quote }}

  - name: external-dns-pihole-c
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - extraArgs:
          - --pihole-server=http://pihole-c-web.networking.svc.cluster.local
          - --pihole-api-version=6
        env:
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_PIHOLE_PASSWORD" | quote }}

  - name: external-dns-technitium
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - provider: rfc2136
        extraArgs:
          - --rfc2136-host=172.16.40.78
          - --rfc2136-port=53
          - --rfc2136-zone=quido.me
          - --rfc2136-tsig-secret-alg=hmac-sha256
          - --rfc2136-tsig-keyname=external-dns
          - --rfc2136-tsig-axfr
        env:
          - name: EXTERNAL_DNS_RFC2136_TSIG_SECRET
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_RFC2136_TSIG_SECRET" | quote }}
