repositories:
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns

releases:
  - name: external-dns-pihole-rt01
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - extraArgs:
          - --pihole-server=http://172.16.40.1
          - --pihole-api-version=6
        env:
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_PIHOLE_PASSWORD" | quote }}

  - name: external-dns-pihole-k8s
    namespace: networking
    chart: external-dns/external-dns
    version: 1.21.1
    values:
      - values.yaml
      - extraArgs:
          - --pihole-server=http://pihole-web.networking.svc.cluster.local
          - --pihole-api-version=6
        env:
          - name: EXTERNAL_DNS_PIHOLE_PASSWORD
            value: {{ fetchSecretValue "ref+vault://kv/networking/external-dns#EXTERNAL_DNS_PIHOLE_PASSWORD" | quote }}
