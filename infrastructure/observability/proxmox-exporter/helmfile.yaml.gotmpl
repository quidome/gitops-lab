repositories: []  # No external repos for local chart

releases:
  - name: proxmox-exporter
    namespace: observability
    chart: ./helm-chart
    wait: true
    timeout: 300
    values:
      - image:
          repository: prompve/prometheus-pve-exporter
          tag: "3.8.1"
          pullPolicy: IfNotPresent

        proxmox:
          host: pve2.lan.balti.casa
          user: {{ fetchSecretValue "ref+vault://kv/observability/proxmox-exporter#PROXMOX_USER" | quote }}
          tokenName: {{ fetchSecretValue "ref+vault://kv/observability/proxmox-exporter#PROXMOX_TOKEN_NAME" | quote }}
          tokenValue: {{ fetchSecretValue "ref+vault://kv/observability/proxmox-exporter#PROXMOX_TOKEN_VALUE" | quote }}
          verifyTls: false  # Internal host with self-signed cert

        resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            memory: 128Mi

        serviceMonitor:
          enabled: true
          interval: 60s
          scrapeTimeout: 10s
          labels: {}

        dashboard:
          enabled: true
          gnetId: 10347
          revision: 1
          datasource: Prometheus
          labels:
            grafana_dashboard: "1"
          annotations:
            grafana_folder: "Infrastructure"
