grafana:
  adminPassword: {{ fetchSecretValue "ref+vault://kv/observability/grafana#admin-password" | quote }}

alertmanager:
  config:
    receivers:
      - name: "null"
      - name: ntfy
        webhook_configs:
          - url: "http://ntfy.observability.svc.cluster.local/homelab-alerts"
            send_resolved: true
            http_config:
              basic_auth:
                username: admin
                password: {{ fetchSecretValue "ref+vault://kv/observability/ntfy#admin-password" | quote }}
