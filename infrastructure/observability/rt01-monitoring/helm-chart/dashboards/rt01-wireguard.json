{
  "uid": "rt01-wireguard",
  "title": "rt01 WireGuard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "tags": ["network", "wireguard", "rt01"],
  "timezone": "browser",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "WireGuard exporter up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{instance=\"rt01.lan.balti.casa\",exporter=\"wireguard\"}", "legendFormat": "wireguard"}]
    },
    {
      "type": "stat",
      "title": "Peers",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "count(wireguard_latest_handshake_seconds{instance=\"rt01.lan.balti.casa\"})", "legendFormat": "peers"}]
    },
    {
      "type": "timeseries",
      "title": "Peer traffic received",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [{"expr": "rate(wireguard_received_bytes_total{instance=\"rt01.lan.balti.casa\"}[5m])", "legendFormat": "{{interface}} {{public_key}}"}]
    },
    {
      "type": "timeseries",
      "title": "Peer traffic sent",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [{"expr": "rate(wireguard_sent_bytes_total{instance=\"rt01.lan.balti.casa\"}[5m])", "legendFormat": "{{interface}} {{public_key}}"}]
    },
    {
      "type": "timeseries",
      "title": "Latest handshake age",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "wireguard_latest_handshake_delay_seconds{instance=\"rt01.lan.balti.casa\"}", "legendFormat": "{{interface}} {{public_key}}"}]
    }
  ]
}
