{
  "uid": "rt01-pihole",
  "title": "Kubernetes Pi-hole",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "tags": ["network", "dns", "pihole", "k8s"],
  "timezone": "browser",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Pi-hole exporters up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=~\"networking/pihole-.*-prometheus-exporter\"}", "legendFormat": "{{pod}}"}]
    },
    {
      "type": "stat",
      "title": "Domains blocked",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "max(pihole_domains_being_blocked{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "domains"}]
    },
    {
      "type": "timeseries",
      "title": "Queries today / ads blocked today",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(pihole_dns_queries_today{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "queries"},
        {"expr": "sum(pihole_ads_blocked_today{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "blocked"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Blocked percentage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "targets": [{"expr": "100 * sum(pihole_ads_blocked_today{job=~\"networking/pihole-.*-prometheus-exporter\"}) / sum(pihole_dns_queries_today{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "blocked %"}]
    },
    {
      "type": "timeseries",
      "title": "Forwarded / cached queries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(pihole_queries_forwarded{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "forwarded"},
        {"expr": "sum(pihole_queries_cached{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "cached"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Clients",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "max(pihole_clients_ever_seen{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "ever seen"},
        {"expr": "max(pihole_unique_clients{job=~\"networking/pihole-.*-prometheus-exporter\"})", "legendFormat": "unique"}
      ]
    }
  ]
}
