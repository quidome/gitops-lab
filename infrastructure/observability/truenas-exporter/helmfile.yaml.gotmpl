repositories: []  # Local chart

releases:
  - name: truenas-exporter
    namespace: observability
    chart: ./helm-chart
    wait: true
    timeout: 300
    values:
      - truenas:
          url: https://172.16.40.64/api/v2.0/pool
          apiKey: {{ fetchSecretValue "ref+vault://kv/observability/truenas-exporter#API_KEY" | quote }}
