{
  "uid": "network-probes",
  "title": "Network Probes",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["network", "blackbox", "latency"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Probe success",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bool", "min": 0, "max": 1}},
      "targets": [{"expr": "probe_success", "legendFormat": "{{job}} {{instance}}"}]
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "probe_duration_seconds", "legendFormat": "{{job}} {{instance}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP status code",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "probe_http_status_code", "legendFormat": "{{instance}}"}]
    },
    {
      "type": "timeseries",
      "title": "DNS lookup time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "probe_dns_lookup_time_seconds", "legendFormat": "{{job}} {{instance}}"}]
    },
    {
      "type": "timeseries",
      "title": "TLS expiry",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "d"}},
      "targets": [{"expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400", "legendFormat": "{{instance}}"}]
    },
    {
      "type": "timeseries",
      "title": "ICMP round-trip time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "probe_icmp_duration_seconds", "legendFormat": "{{instance}} {{phase}}"}]
    }
  ]
}
