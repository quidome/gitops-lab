    {
      "id": 5,
      "type": "stat",
      "title": "Lights on",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(((hass_light_brightness_percent{entity!=\"light.lampen_tv\"}) * on(entity) group_left(area) hass_entity_info{area!~\"it|car\"} * on(area) group_left(area_name) hass_area_info) > 0) or vector(0)",
          "legendFormat": "Lights on",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Lights with brightness above 0. The light group 'Lampen TV' and the access point LEDs are not counted."
