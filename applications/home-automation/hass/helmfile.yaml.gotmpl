repositories:
  - name: pajikos
    url: https://pajikos.github.io/home-assistant-helm-chart/

releases:
  - name: hass
    namespace: home-automation
    chart: pajikos/home-assistant
    version: "0.3.93"
    values:
      - values.yaml
  - name: hass-resources
    namespace: home-automation
    chart: ./resources
    values:
      - prometheusToken: {{ fetchSecretValue "ref+vault://kv/home-automation/hass#PROMETHEUS_TOKEN" | quote }}
